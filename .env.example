# Discord configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_SERVER_ID=your_discord_server_guild_id

# Channel where private match threads are created (must be a text channel)
MATCH_MANAGEMENT_CHANNEL_ID=your_match_management_channel_id

# Roles
ADMINISTRATOR_ROLE_ID=your_administrator_role_id
COMPETITION_STAFF_ROLE_ID=your_competition_staff_role_id
SUPPORT_CHANNEL_ID=your_support_channel_id

# Match module role gates
MATCH_MODULE_ONLY=false  # true = only module commands, false = legacy + module commands

# Competition behaviour
RESULT_CONFIRMATION_POLICY=both_teams  # both_teams | administrator | automatic
INTERACTION_EXPIRATION=300000            # Confirmation lifetime in ms (5 minutes)
MAX_FILE_SIZE=10485760                 # Max upload size in bytes (10 MB)
API_RATE_LIMIT_WINDOW_MS=900000        # API rate limit window in ms
API_RATE_LIMIT_MAX=100                  # Max API requests per window
LOG_LEVEL=info                         # log level (info, debug, info, etc.)
LOG_FILE=logs/app.log                  # Optional log file path (omit for stdout only)

# Process toggles
ENABLE_BOT=true                        # Enable bot (default: true outside tests)
ENABLE_API=true                        # Enable API (default: true outside tests)
ENABLE_DEV_COMMANDS=true               # Enable development-only commands (default: true outside production)

# Environment
NODE_ENV=development                   # development | test | production
EOF