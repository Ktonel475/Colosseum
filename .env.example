# =============================================================================
# Discord competition management bot - environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Boolean values accept: true | false | 1 | 0
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Discord application
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
# The server (guild) ID is detected automatically when the bot joins a server.

# -----------------------------------------------------------------------------
# Channels
# -----------------------------------------------------------------------------
# Parent text channel where private match threads are created.
MATCH_MANAGEMENT_CHANNEL_ID=your_match_management_channel_id
SUPPORT_CHANNEL_ID=your_support_channel_id

# -----------------------------------------------------------------------------
# Roles
# -----------------------------------------------------------------------------
# Single admin gate: used by admin/staff checks and by the match module
# (/match-create, /match-create-bulk and /result).
ADMINISTRATOR_ROLE_ID=your_administrator_role_id
COMPETITION_STAFF_ROLE_ID=your_competition_staff_role_id

# -----------------------------------------------------------------------------
# Match module
# -----------------------------------------------------------------------------
# false = register module commands and keep the remaining legacy match/result
#         commands (match-list, match-info, match-close, result-status,
#         result-review, result-edit, result-cancel).
# true  = register only the module commands:
#         /match-create, /match-create-bulk, /result, and skip the automatic
#         newcomer welcome DM. All other commands and features stay available.
MATCH_MODULE_ONLY=false

# -----------------------------------------------------------------------------
# Competition behaviour
# -----------------------------------------------------------------------------
RESULT_CONFIRMATION_POLICY=both_teams
INTERACTION_EXPIRATION=300000
MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# HTTP API
# -----------------------------------------------------------------------------
API_PORT=3000
API_AUTH_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=*
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Database (path is resolved relative to prisma/schema.prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=file:../data/dev.db

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# Process toggles
# -----------------------------------------------------------------------------
ENABLE_BOT=true
ENABLE_API=true
ENABLE_DEV_COMMANDS=true
