{
  "name": "discord-competition-management-bot",
  "version": "1.0.0",
  "description": "Discord bot for managing competition teams, players, matches and results",
  "type": "module",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "bot": "node src/bot/start.js",
    "dev": "node --watch src/api/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": ["discord", "bot", "competition", "management", "team", "match", "result"],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.0.0",
    "pino": "^8.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
